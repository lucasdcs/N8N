    {
      "parameters": {
        "jsCode": "// ===================== CONFIGURACAO =====================\n// ASSUNTOS: ids dos assuntos de O.S. que disparam o cadastro, por base.\n// Base com lista vazia = ignorada. Ex.: PONTO: ['70'].\nconst ASSUNTOS = {\n  'RESOLUTTO': ['69'],\n  '4BTELECOM': ['89'],\n  'PONTO':     ['61'],\n  'CACTA':     ['73'],\n  'BUZZ':      ['83'],\n};\n\n// SIMULAR = true -> calcula tudo (login, nome, sobrenome) mas NAO cria no GLPI.\n// Confira a saida do no \"Decidir\" e depois troque para false.\nconst SIMULAR = false;\n\n// GLPI de TESTE (mesma VM do n8n de teste). Producao: https://support.resolutto.com.br\nconst GLPI_URL       = 'https://support.resolutto.com.br';\nconst GLPI_ENTIDADE  = 0;   // entidade do perfil do novo usuario\nconst GLPI_PERFIL    = 1;   // 0 = perfil padrao do GLPI (normalmente Self-Service)\nconst GLPI_RECURSIVO = 0;   // 1 = perfil recursivo nas sub-entidades\n\n// So olha O.S. abertas a partir de hoje menos N dias (00:00, horario de Brasilia).\nconst DIAS_RETROATIVOS = 2;\n// ========================================================\n\nconst desde = DateTime.now().setZone('America/Sao_Paulo')\n  .minus({ days: DIAS_RETROATIVOS }).startOf('day').toFormat('yyyy-LL-dd HH:mm:ss');\n\nreturn [{ json: {\n  ASSUNTOS, SIMULAR, GLPI_URL, GLPI_ENTIDADE, GLPI_PERFIL, GLPI_RECURSIVO,\n  DIAS_RETROATIVOS, desde,\n} }];\n"
      },
