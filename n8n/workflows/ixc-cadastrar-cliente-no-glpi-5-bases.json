    {
      "parameters": {
        "jsCode": "// Le a resposta do GLPI e marca o cliente como tratado.\nconst st = $getWorkflowStaticData('global');\nst.feitos = st.feitos || {};\nconst res = $input.all();\nreturn res.map((r, i) => {\n  const p = $('Decidir1').itemMatching(i).json;\n  let v = r.json.data;\n  try { v = JSON.parse(v); } catch (e) {}\n  const ok = v && !Array.isArray(v) && Number(v.id) > 0;\n  if (ok) st.feitos[`${p.base}:${p.id_cliente}`] = Date.now();\n  return { json: {\n    ok, base: p.base, id_os: p.id_os, id_cliente: p.id_cliente,\n    login: p.login, nome: p.input.firstname, sobrenome: p.input.realname,\n    glpi_user_id: ok ? Number(v.id) : null,\n    erro: ok ? null : String(r.json.data).slice(0, 300),\n  } };\n});\n"
      },
