    {
      "parameters": {
        "jsCode": "const STOP = new Set(['da', 'de', 'do', 'das', 'dos', 'e']);\nfunction palavras(s) {\n  return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '')\n    .toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim().split(' ').filter(Boolean);\n}\n// \"primeironome.l\": 1a palavra com letra da razao social + \".\" + 1a letra do nome fantasia.\n// Sem fantasia: usa a 1a letra da palavra seguinte da razao (ignorando da/de/do...).\nfunction gerarLogin(razao, fantasia) {\n  const p = palavras(razao);\n  const i = p.findIndex(w => /[a-z]/.test(w));      // pula o CNPJ no inicio de razao de MEI\n  const primeiro = i >= 0 ? p[i] : 'cliente';\n  const f = palavras(fantasia).filter(w => /[a-z]/.test(w) && !STOP.has(w));\n  let letra = f.length ? f[0][0] : '';\n  if (!letra) { const resto = p.slice(i + 1).filter(w => /[a-z]/.test(w) && !STOP.has(w)); letra = resto.length ? resto[0][0] : ''; }\n  return letra ? `${primeiro}.${letra}` : primeiro;\n}\n// Junta O.S. + cliente do IXC e monta os dados do usuario GLPI.\nfunction parse(txt) {\n  if (txt && typeof txt === 'object') return txt;\n  const s = String(txt || '').replace(/[\\u0000-\\u001F]/g, ' ');\n  try { return JSON.parse(s); } catch (e) {\n    const a = s.indexOf('{'), b = s.lastIndexOf('}');\n    if (a >= 0 && b > a) { try { return JSON.parse(s.slice(a, b + 1)); } catch (e2) {} }\n    return null;\n  }\n}\nconst limpa = s => String(s || '').replace(/\\s+/g, ' ').trim();\n\nconst out = [];\nconst itens = $input.all();\nfor (let i = 0; i < itens.length; i++) {\n  let os = null;\n  try { os = $('Extrair OS1').itemMatching(i).json; } catch (e) {}\n  const obj = parse(itens[i].json.data);\n  const cli = obj && Array.isArray(obj.registros) ? obj.registros[0] : null;\n  if (!os || !cli) { console.log('cliente nao encontrado', JSON.stringify(os), String(itens[i].json.data).slice(0, 200)); continue; }\n  const razao = limpa(cli.razao);\n  const fantasia = limpa(cli.fantasia);\n  if (!razao) { console.log(`[${os.base}] cliente ${cli.id} sem razao social`); continue; }\n  out.push({ json: {\n    base: os.base, id_os: os.id_os, id_cliente: String(cli.id),\n    razao, fantasia, cnpj_cpf: limpa(cli.cnpj_cpf),\n    registro: `IXC-${os.base}-${cli.id}`,\n    login_base: gerarLogin(razao, fantasia),\n  } });\n}\nreturn out;\n"
      },
