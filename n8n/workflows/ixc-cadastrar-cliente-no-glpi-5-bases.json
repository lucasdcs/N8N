    {
      "parameters": {
        "jsCode": "// Junta as O.S. das 5 bases, filtra pelos assuntos do Config,\n// tira clientes ja tratados e devolve 1 item por cliente novo.\nconst cfg = $('Config1').first().json;\nconst st = $getWorkflowStaticData('global');\nst.feitos = st.feitos || {};\nconst limite = Date.now() - (Number(cfg.DIAS_RETROATIVOS) + 3) * 86400000;\nfor (const k of Object.keys(st.feitos)) if (st.feitos[k] < limite) delete st.feitos[k];\n\nfunction parse(txt) {\n  if (txt && typeof txt === 'object') return txt;\n  const s = String(txt || '').replace(/[\\u0000-\\u001F]/g, ' ');\n  try { return JSON.parse(s); } catch (e) {\n    const a = s.indexOf('{'), b = s.lastIndexOf('}');\n    if (a >= 0 && b > a) { try { return JSON.parse(s.slice(a, b + 1)); } catch (e2) {} }\n    return null;\n  }\n}\n\n// $('Nome') precisa ser literal no n8n 2.x\nconst respostas = {\n  'RESOLUTTO': $('OS RESOLUTTO1').first().json,\n  '4BTELECOM': $('OS 4BTELECOM1').first().json,\n  'PONTO':     $('OS PONTO1').first().json,\n  'CACTA':     $('OS CACTA1').first().json,\n  'BUZZ':      $('OS BUZZ1').first().json,\n};\nconst ORDEM = ['RESOLUTTO', '4BTELECOM', 'PONTO', 'CACTA', 'BUZZ'];\n\nconst out = [];\nORDEM.forEach((base, saida) => {\n  const assuntos = (cfg.ASSUNTOS[base] || []).map(String);\n  if (!assuntos.length) return;\n  const r = respostas[base] || {};\n  const obj = parse(r.data);\n  if (!obj || obj.type === 'error') {\n    console.log(`[${base}] erro ao listar O.S.:`, r.error ? JSON.stringify(r.error) : String(r.data).slice(0, 300));\n    return;\n  }\n  const vistos = new Set();\n  for (const os of (obj.registros || [])) {\n    if (!assuntos.includes(String(os.id_assunto))) continue;\n    const idc = String(os.id_cliente || '');\n    if (!idc || idc === '0' || vistos.has(idc)) continue;\n    vistos.add(idc);\n    if (st.feitos[`${base}:${idc}`]) continue;\n    out.push({ json: {\n      base, saida, id_os: String(os.id), id_cliente: idc,\n      id_assunto: String(os.id_assunto), data_abertura: os.data_abertura,\n    } });\n  }\n});\nreturn out;\n"
      },
      "id": "9ea81eec-3549-44e5-b6ab-50cbac8a7e63",
