      "id": "3c149e01-77f4-474d-a5d1-c099cafb5282",
      "name": "GLPI buscar login1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2544,
        720
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "amEfvZPZVm9URFks",
          "name": "GLPI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Para cada cliente: ja existe no GLPI (pela matricula IXC-BASE-ID)? Se nao,\n// escolhe o login livre. Sai 1 item por cliente com 'acao':\n// criar | criar (simulado) | ja_existe | erro_glpi (com a resposta do GLPI).\n// escolhe o login livre (joao.s, joao.s2, joao.s3...) e monta o input.\nconst cfg = $('Config1').first().json;\nconst st = $getWorkflowStaticData('global');\nst.feitos = st.feitos || {};\n\nfunction lista(txt) {\n  let v = txt;\n  if (typeof v === 'string') { try { v = JSON.parse(v); } catch (e) { return null; } }\n  if (!Array.isArray(v)) return null;\n  if (v.length === 2 && typeof v[0] === 'string' && v[0].startsWith('ERROR')) return null;\n  return v;\n}\nconst esc = s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n\nconst clientes = $('Reemitir1').all();\nconst reg = $('GLPI buscar registro1').all();\nconst lg = $('GLPI buscar login1').all();\nconst reservados = new Set();\nconst out = [];\n\nfor (let i = 0; i < clientes.length; i++) {\n  const c = clientes[i].json;\n  const chave = `${c.base}:${c.id_cliente}`;\n  const existentes = lista(reg[i] && reg[i].json.data);\n  const logins = lista(lg[i] && lg[i].json.data);\n  if (existentes === null || logins === null) {\n    out.push({ json: { ...c, acao: 'erro_glpi',\n      resposta_registro: String((reg[i] || {}).json?.data ?? (reg[i] || {}).json?.error?.message).slice(0, 300),\n      resposta_login: String((lg[i] || {}).json?.data ?? (lg[i] || {}).json?.error?.message).slice(0, 300) } });\n    continue;\n  }\n  if (existentes.length) {\n    if (!cfg.SIMULAR) st.feitos[chave] = Date.now();\n    out.push({ json: { ...c, acao: 'ja_existe', glpi_login: existentes[0].name, glpi_user_id: existentes[0].id } });\n    continue;\n  }\n  const re = new RegExp('^' + esc(c.login_base) + '(\\\\d*)$');\n  const usados = new Set(logins.map(u => String(u.name || '').toLowerCase()).filter(n => re.test(n)));\n  let login = c.login_base, n = 2;\n  while (usados.has(login) || reservados.has(login)) login = c.login_base + n++;\n  reservados.add(login);\n\n  const input = {\n    name: login,\n    firstname: c.razao,          // \"Nome\" no GLPI\n    realname: c.fantasia,        // \"Sobrenome\" no GLPI\n    registration_number: c.registro,\n    comment: `Criado pelo n8n a partir da O.S. ${c.id_os} do IXC ${c.base} (cliente ${c.id_cliente}${c.cnpj_cpf ? ', ' + c.cnpj_cpf : ''}).`,\n    is_active: 1,\n    _entities_id: Number(cfg.GLPI_ENTIDADE),\n    _is_recursive: Number(cfg.GLPI_RECURSIVO),\n  };\n  if (Number(cfg.GLPI_PERFIL) > 0) input._profiles_id = Number(cfg.GLPI_PERFIL);\n  out.push({ json: { ...c, acao: cfg.SIMULAR ? 'criar (simulado)' : 'criar', login, input } });\n}\nreturn out;\n"
      },
