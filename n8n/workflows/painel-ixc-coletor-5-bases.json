      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// {base, pular, resp} por base (o item pareado em \"Requisições de clientes\" diz de quem é).\nconst msgErro = (e) => typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify(e);\nconst lerIxc = (j) => {\n  if (!j) return { error: 'sem resposta' };\n  if (j.error) return { error: msgErro(j.error) };\n  const raw = j.data;\n  if (raw === undefined) return j;\n  if (typeof raw !== 'string') return raw;\n  const txt = raw.replace(/^﻿/, '').trim();\n  try { return JSON.parse(txt); } catch (e) { /* tenta limpar */ }\n  try { return JSON.parse(txt.replace(/[\\u0000-\\u001F]+/g, ' ')); } catch (e) {\n    return { error: 'resposta do IXC não é JSON (' + txt.length + ' bytes): ' + txt.slice(0, 180) };\n  }\n};\nconst req = $('Requisições de clientes').item.json;\nreturn { json: { base: req.base, pular: !!req.pular, resp: req.pular ? { total: 0, registros: [] } : lerIxc($input.item.json || {}) } };"
      },
