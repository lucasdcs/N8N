    {
      "parameters": {
        "jsCode": "// ====== CONFIGURAÇÃO DO COLETOR (edite só este bloco) ======\nconst PAINEL_URL   = 'https://support.resolutto.com.br/plugins/painelixc/front/ingest.php';     // ingest do plugin GLPI (Configurar > Geral > Painel IXC)\nconst PAINEL_TOKEN = '__PAINEL_TOKEN__';\nconst STATUS_FECHADOS = 'F,C';             // \"aberta\" = status diferente destes\nconst RESOLVIDAS_DIAS = 90;          // janela das resolvidas (histórico do plugin)\nconst BASES = [                            // credencial de cada base fica no nó \"IXC <base>\"\n  { codigo: 'resolutto', nome: 'Resolutto', url: 'https://ixc.resolutto.com.br' },\n  { codigo: '4btelecom', nome: '4BTELECOM', url: 'https://ixc.4btelecom.com.br' },\n  { codigo: 'ponto',     nome: 'PONTO',     url: 'https://ixc.pontotelecom.com' },\n  { codigo: 'cacta',     nome: 'CACTA',     url: 'https://ixc.cactatelecom.com.br' },\n  { codigo: 'buzz',      nome: 'BUZZ',      url: 'https://ixc.buzztelecom.com.br' },\n];\n// ============================================================\n// TIPO vem do gatilho que disparou: 03:10 / \"Manual (resolvidas)\" = resolvidas; os outros = abertas.\nconst gatilho = String($prevNode.name || '');\nconst tipo = /resolvidas/i.test(gatilho) ? 'resolvidas' : 'abertas';\nreturn [{ json: { PAINEL_URL, PAINEL_TOKEN, STATUS_FECHADOS, RESOLVIDAS_DIAS, TIPO: tipo, GATILHO: gatilho,\n  BASES: BASES.map(b => ({ ...b, url: String(b.url || '').trim().replace(/\\/+$/, '') })) } }];"
      },
      "id": "9635d181-392d-596c-95b1-29fdbb69f02a",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Uma requisição por (base × tabela). O nó HTTP da base executa cada uma (url/corpo vêm do item).\nconst cfg = $input.first().json;\nconst dias = parseInt(cfg.RESOLVIDAS_DIAS, 10) || 90;\nconst desde = new Date(Date.now() - dias * 86400000).toISOString().slice(0, 10) + ' 00:00:00';\nconst fechados = String(cfg.STATUS_FECHADOS || 'F,C').split(',').map(s => s.trim()).filter(Boolean);\nconst gridOs = cfg.TIPO === 'resolvidas'\n  ? [{ TB: 'su_oss_chamado.status', OP: '=', P: 'F' }, { TB: 'su_oss_chamado.data_fechamento', OP: '>=', P: desde }]\n  : fechados.map(st => ({ TB: 'su_oss_chamado.status', OP: '!=', P: st }));   // o IXC não aceita IN em status\nconst lista = (tab) => ({ qtype: tab + '.id', query: '0', oper: '>', page: '1', rp: '5000', sortname: tab + '.id', sortorder: 'asc' });\nconst TABELAS = [\n  ['os',           'su_oss_chamado',    { qtype: 'su_oss_chamado.id', query: '0', oper: '>', page: '1', rp: '5000', sortname: 'su_oss_chamado.id', sortorder: 'desc', grid_param: JSON.stringify(gridOs) }],\n  ['assuntos',     'su_oss_assunto',    lista('su_oss_assunto')],\n  ['tecnicos',     'funcionarios',      lista('funcionarios')],\n  ['setores',      'empresa_setor',     lista('empresa_setor')],\n  ['diagnosticos', 'su_diagnostico',    lista('su_diagnostico')],\n  ['condominios',  'cliente_condominio', lista('cliente_condominio')],\n];\nconst out = [];\nfor (const b of cfg.BASES) {\n  if (!/^https?:\\/\\/\\S+$/i.test(b.url) || /PREENCHER/i.test(b.url)) {\n    out.push({ json: { base: b.codigo, chave: 'os', url: '', corpo: {}, erro_config: 'URL do IXC não preenchida no nó Config (' + b.nome + ')' } });\n    continue;\n  }\n  for (const [chave, tab, corpo] of TABELAS) out.push({ json: { base: b.codigo, chave, url: b.url + '/webservice/v1/' + tab, corpo } });\n}\nreturn out;"
      },
