          "name": "IXC API (BUZZ TELECOM)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Junta tudo num retrato por base e manda só os campos que o painel usa.\n// Se a busca de O.S. de uma base falhou, manda {base, erro} — o painel registra e NÃO encerra nenhuma O.S. dessa base.\nconst msgErro = (e) => typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify(e);\nconst lerIxc = (j) => {\n  if (!j) return { error: 'sem resposta' };\n  if (j.error) return { error: msgErro(j.error) };\n  const raw = j.data;\n  if (raw === undefined) return j;\n  if (typeof raw !== 'string') return raw;\n  const txt = raw.replace(/^﻿/, '').trim();\n  try { return JSON.parse(txt); } catch (e) { /* tenta limpar */ }\n  try { return JSON.parse(txt.replace(/[\\u0000-\\u001F]+/g, ' ')); } catch (e) {\n    return { error: 'resposta do IXC não é JSON (' + txt.length + ' bytes): ' + txt.slice(0, 180) };\n  }\n};\nconst cfg = $('Config').first().json;\nconst tipo = cfg.TIPO === 'resolvidas' ? 'resolvidas' : 'abertas';\nconst agrupado = {}; for (const it of $('Agrupar por base').all()) agrupado[it.json.base] = it.json;\nconst clientesResp = {};\nfor (const it of $input.all()) clientesResp[it.json.base] = it.json;   // vindo de \"Ler clientes\": {base, pular, resp}\nconst CAMPOS_OS = ['id', 'protocolo', 'status', 'prioridade', 'id_assunto', 'setor', 'id_tecnico', 'id_cliente',\n  'id_condominio', 'id_su_diagnostico', 'id_ticket', 'mensagem', 'mensagem_resposta', 'data_abertura', 'data_agenda',\n  'data_inicio', 'data_final', 'data_fechamento', 'ultima_atualizacao'];\nconst out = [];\nfor (const b of cfg.BASES) {\n  const g = agrupado[b.codigo]; const base = b.codigo; const url = b.url;\n  const erro = (msg) => out.push({ json: { base, tipo, erro: String(msg).slice(0, 900) } });\n  if (!g) { erro('base sem respostas'); continue; }\n  const r = g.resp.os || { error: 'sem resposta' };\n  if (r.error) { erro('Falha ao buscar O.S. no IXC: ' + msgErro(r.error)); continue; }\n  if (r.type === 'error') { erro('IXC recusou a busca de O.S.: ' + (r.message || JSON.stringify(r))); continue; }\n  const total = Number(r.total);\n  if (!Number.isFinite(total)) { erro('Resposta inesperada do IXC (sem \"total\"): ' + JSON.stringify(r).slice(0, 300)); continue; }\n  const regs = Array.isArray(r.registros) ? r.registros : [];\n  if (total > 0 && regs.length === 0) { erro('IXC informou ' + total + ' O.S. mas não mandou registros'); continue; }\n  const os = regs.map(o => { const x = {}; for (const k of CAMPOS_OS) if (o[k] !== undefined) x[k] = (k === 'mensagem' || k === 'mensagem_resposta') ? String(o[k] || '').slice(0, 2000) : o[k]; return x; });\n  const avisos = [];\n  const dic = (j, nome, campos) => {\n    if (!j || j.error || j.type === 'error' || !Array.isArray(j.registros)) {\n      if (!(j && Number(j.total) === 0)) avisos.push(nome + ': ' + (j && (j.error ? msgErro(j.error) : j.message) || 'sem registros'));\n      return [];\n    }\n    return j.registros.map(o => { const x = { id: o.id }; for (const c of campos) if (o[c] !== undefined) x[c] = o[c]; return x; });\n  };\n  const cr = clientesResp[base];\n  const clientesJ = (!cr || cr.pular) ? { total: 0, registros: [] } : cr.resp;\n  out.push({ json: { base, tipo, ixc_url: url, total, os,\n    assuntos: dic(g.resp.assuntos, 'assuntos', ['assunto']), tecnicos: dic(g.resp.tecnicos, 'tecnicos', ['funcionario']),\n    setores: dic(g.resp.setores, 'setores', ['setor']), clientes: os.length ? dic(clientesJ, 'clientes', ['razao', 'fantasia', 'id_condominio']) : [],\n    diagnosticos: dic(g.resp.diagnosticos, 'diagnosticos', ['descricao']), condominios: dic(g.resp.condominios, 'condominios', ['condominio']), avisos } });\n}\nreturn out;"
      },
      "id": "d87c8c15-a828-5adc-82c9-17a033e1b67f",
      "name": "Montar retratos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3232,
