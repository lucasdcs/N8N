    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Devolve {base, chave, resp} para cada resposta do IXC (o item pareado em \"Requisições\" diz de quem é).\nconst msgErro = (e) => typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify(e);\nconst lerIxc = (j) => {\n  if (!j) return { error: 'sem resposta' };\n  if (j.error) return { error: msgErro(j.error) };\n  const raw = j.data;\n  if (raw === undefined) return j;\n  if (typeof raw !== 'string') return raw;\n  const txt = raw.replace(/^﻿/, '').trim();\n  try { return JSON.parse(txt); } catch (e) { /* tenta limpar */ }\n  try { return JSON.parse(txt.replace(/[\\u0000-\\u001F]+/g, ' ')); } catch (e) {\n    return { error: 'resposta do IXC não é JSON (' + txt.length + ' bytes): ' + txt.slice(0, 180) };\n  }\n};\nconst req = $('Requisições').item.json;\nconst j = $input.item.json || {};\nconst resp = req.erro_config ? { error: req.erro_config } : lerIxc(j);\nreturn { json: { base: req.base, chave: req.chave, resp } };"
      },
      "id": "a681fb50-67c3-5cab-acc8-676f53795820",
      "name": "Ler respostas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Agrupa as respostas por base e prepara a busca de clientes (só os ids que aparecem nas O.S.).\nconst cfg = $('Config').first().json;\nconst porBase = {};\nfor (const b of cfg.BASES) porBase[b.codigo] = { base: b.codigo, nome: b.nome, url: b.url, resp: {} };\nfor (const it of $input.all()) { const j = it.json; if (porBase[j.base]) porBase[j.base].resp[j.chave] = j.resp; }\nconst out = [];\nfor (const b of Object.values(porBase)) {\n  const r = b.resp.os || { error: 'sem resposta' };\n  const os = (!r.error && r.type !== 'error' && Array.isArray(r.registros)) ? r.registros : [];\n  const ids = [...new Set(os.map(o => String(o.id_cliente || '')).filter(i => /^\\d+$/.test(i) && i !== '0'))];\n  out.push({ json: { base: b.base, nome: b.nome, url: b.url, chave: 'clientes', pular: ids.length === 0 || !b.url,\n    url_req: b.url + '/webservice/v1/cliente', resp: b.resp,\n    corpo: { qtype: 'cliente.id', query: '0', oper: '>', page: '1', rp: String(Math.max(ids.length, 1)), sortname: 'cliente.id', sortorder: 'asc',\n             grid_param: JSON.stringify([{ TB: 'cliente.id', OP: 'IN', P: ids.length ? ids.join(',') : '0' }]) } } });\n}\nreturn out;"
      },
      "id": "d85e8951-3c4b-5de5-84a5-b9b0f56a3a84",
      "name": "Agrupar por base",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Item para o nó HTTP da base (url/corpo). Bases sem O.S. com cliente não precisam consultar.\nreturn $input.all().map(it => ({ json: { base: it.json.base, chave: 'clientes', url: it.json.url_req, corpo: it.json.corpo, pular: it.json.pular } }));"
      },
